# Configure estes valores no painel da Vercel, nunca em app.js.
# Exemplo apenas: substitua a conexão inteira pela fornecida pelo banco.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BASE?sslmode=require
# Escolha uma chave longa e privada (pelo menos 24 caracteres).
# Ela será solicitada apenas para criar o primeiro administrador.
PRATES_SETUP_KEY=SUBSTITUA_POR_UMA_CHAVE_PRIVADA_LONGA
